# Copy this file to ".env" and fill in real values. The .env file is gitignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI providers ---
# Primary: Vertex AI Gemini (use a Vertex Express key — see DEVELOPER_GUIDE.md section 17)
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
# Fallback: OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: Replicate (paid — clothing try-on / 3D fallback)
REPLICATE_API_TOKEN=your-replicate-api-token

# --- Optional overrides (have sensible defaults) ---
# HAIR_TRY_ON_PROVIDER=gemini
# STYLING_TRY_ON_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
